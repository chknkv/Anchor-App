<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Запрещает cleartext HTTP для всех доменов.
        Certificate pinning добавить после получения production-сертификата.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
